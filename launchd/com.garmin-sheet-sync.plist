<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs garmin-sheet-sync.mjs every 2 hours on macOS.
  Replace the three REPLACE_ME paths (see README), copy this file to
  ~/Library/LaunchAgents/, then: launchctl load ~/Library/LaunchAgents/com.garmin-sheet-sync.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.garmin-sheet-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_ME_NODE_PATH</string>          <!-- output of: which node -->
    <string>REPLACE_ME_REPO_PATH/garmin-sheet-sync.mjs</string>
  </array>

  <!-- Every 2 hours, plus once at login. Runs where nothing changed submit nothing, so frequent
       runs are cheap, and they cover a run that fails because Wi-Fi isn't up yet after waking or
       because the watch hasn't synced last night's sleep yet. A run missed while asleep happens on wake. -->
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPLACE_ME_HOME/Library/Logs/garmin-sheet-sync.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_ME_HOME/Library/Logs/garmin-sheet-sync.log</string>
</dict>
</plist>
